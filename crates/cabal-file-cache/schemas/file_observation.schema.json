{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cabal-runtime.local/schemas/file_observation.v1.json",
  "title": "Cabal FileObservation v1",
  "type": "object",
  "required": [
    "status",
    "path",
    "requested",
    "omitted_changed_ranges",
    "completeness"
  ],
  "properties": {
    "status": { "enum": ["content", "unchanged", "changed"] },
    "path": { "type": "string" },
    "requested": { "type": "object" },
    "content": { "type": "string", "maxLength": 262144 },
    "changed_ranges": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["old_start", "old_lines", "new_start", "new_lines"]
      }
    },
    "omitted_changed_ranges": { "type": "integer", "minimum": 0 },
    "completeness": { "type": "string" }
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "cabal-runtime-hook pre-tool-use",
            "timeout": 30,
            "statusMessage": "Running validation"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "cabal-runtime-hook invalidate-file-cache",
            "timeout": 10,
            "statusMessage": "Refreshing file observations"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "cabal-runtime-hook refresh-repository-map",
            "timeout": 30,
            "statusMessage": "Refreshing repository map"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cabal-runtime-hook register-causal-frame",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cabal-runtime-hook invalidate-file-cache",
            "timeout": 10,
            "statusMessage": "Starting file observations"
          },
          {
            "type": "command",
            "command": "cabal-runtime-hook refresh-repository-map",
            "timeout": 30,
            "statusMessage": "Indexing repository"
          },
          {
            "type": "command",
            "command": "cabal-runtime-hook cleanup-causal-context",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cabal-runtime-hook stop",
            "timeout": 10,
            "statusMessage": "Checking completion evidence"
          }
        ]
      }
    ]
  }
}

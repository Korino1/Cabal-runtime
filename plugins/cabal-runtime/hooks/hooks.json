{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:PLUGIN_ROOT\\scripts\\post_tool_use.ps1\"",
            "timeout": 30,
            "statusMessage": "Processing command result"
          }
        ]
      }
    ]
  }
}
